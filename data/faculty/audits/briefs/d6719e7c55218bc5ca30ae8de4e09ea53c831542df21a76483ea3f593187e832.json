    "source_precedence": [
      "Specific official appointment type or effective-date information disambiguates a generic roster title.",
      "Official designated EE/ECE roster or EE track establishes membership in a combined department.",
      "A specific official appointment type or future-start designation takes precedence over an undated generic biography. Courtesy qualifies under this policy; other excluded appointment types remain excluded.",
      "Conflicting equally specific official claims remain unresolved until reviewed.",
      "Personal sites, ORCID, and bibliographic records corroborate individual claims and reveal omissions; they do not independently override official EE/ECE membership."
    ],
    "joint_appointments": "An explicit professorial EE/ECE joint or secondary appointment qualifies, including courtesy appointments. Retain an explicit courtesy designation; use joint_secondary when the official source does not establish the regular-versus-courtesy subtype. The missing subtype alone does not block an affiliation count. Count each person once per institution without inferring FTE.",
    "publication_membership_rule": "ECE-venue authorship is discovery evidence only. A CS professor qualifies only with an official EE/ECE professorial affiliation/appointment; CS-only contributors remain excluded.",
    "temporal_scope": "Latest accepted roster observation, including announced incoming appointments and a separate incoming subtotal. Publication-year filters do not change faculty counts. Historical school rosters are deferred.",
    "change_authority": "User explicitly approved counting professors officially listed by the ECE department as affiliate or below-the-line faculty, even without courtesy/joint terminology. Generic lab affiliates and the other excluded roles remain excluded.",
    "ranking_effect": "None. Existing institution-level publication credit and scoring are unchanged.",
    "public_count_gate": "All candidate entries adjudicated, full official source enumeration checked, no unresolved inclusion decisions, evidence references valid, and independent review reconciled.",
    "metric_id": "ece_affiliated_faculty",
    "count_basis": "Official EE/ECE regular, in-residence, courtesy, joint/secondary and affiliated/below-the-line professors, including announced incoming appointments; each person once per school, not FTE.",
    "category_rules": {
      "courtesy": "Explicit university EE/ECE professorial appointment by courtesy; a generic affiliation or lab membership is insufficient.",
      "joint_secondary": "Official EE/ECE professorial joint/secondary appointment, with regular-versus-courtesy subtype unspecified. Preserve an explicit affiliate/below-the-line designation as affiliate_professor instead of guessing joint; generic lab affiliation alone is insufficient.",
      "affiliate_professor": "A professor officially designated by the university EE/ECE department as affiliate or below-the-line faculty. A formal EE/ECE professorial affiliation qualifies even when the primary professorship is in CS or another unit. Generic lab/research-network membership, adjunct, teaching-only, research-only, emeritus and retired roles remain excluded."
    }
